DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=obsoletehq.com,www.obsoletehq.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://obsoletehq.com,https://www.obsoletehq.com
DJANGO_RUN_MIGRATIONS=true
DJANGO_SEED_ON_STARTUP=true
POSTGRES_DB=obsoletehq
POSTGRES_USER=obsoletehq
POSTGRES_PASSWORD=replace-with-a-strong-password
WEB_PORT=8000
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp-relay.brevo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_HOST_USER=replace-with-brevo-smtp-login
DJANGO_EMAIL_HOST_PASSWORD=replace-with-brevo-smtp-key
DEFAULT_FROM_EMAIL=hello@obsoletehq.com
EMAIL_VERIFICATION_TIMEOUT=259200
EMAIL_VERIFICATION_RESEND_SECONDS=300
